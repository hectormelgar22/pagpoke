---
/* Logotipo de la tienda ficticia. Para una tienda real, sustituir por su logotipo (SVG o PNG). */
import { tienda } from '../data/tienda.ts';
interface Props { clase?: string }
const { clase = 'logo' } = Astro.props;
---
<a href="/" class={clase} aria-label={`${tienda.nombre} Cartas · Torneos, ir al inicio`}>
  <svg viewBox="0 0 34 34" aria-hidden="true">
    <rect x="7" y="3" width="21" height="28" rx="3" transform="rotate(8 17 17)" fill="#FFCB05" />
    <rect x="9.5" y="6" width="16" height="22" rx="1.5" transform="rotate(8 17 17)" fill="none" stroke="#14264F" stroke-width="1.6" />
    <text x="17.6" y="23" text-anchor="middle" font-family="Barlow Condensed, Arial Narrow, sans-serif" font-weight="700" font-size="15" fill="#14264F" transform="rotate(8 17 17)">D</text>
  </svg>
  <span class="logo-texto">{tienda.nombre}<small>Cartas · Torneos</small></span>
</a>
