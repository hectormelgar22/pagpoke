---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Horario from '../components/Horario.astro';
import Mapa from '../components/Mapa.astro';
import { tienda, direccionCompleta, enlaceWhatsApp } from '../data/tienda.ts';
import { FOTOS } from '../data/fotos.ts';
import { icono } from '../lib/iconos.ts';

const galeria = [
  { f: FOTOS.tienda, c: 'g-a' }, { f: FOTOS.vitrina, c: 'g-b' }, { f: FOTOS.comunidad, c: 'g-c' }, { f: FOTOS.sobres, c: 'g-d' },
  { f: FOTOS.zonaJuego, c: 'g-e' }, { f: FOTOS.archivador, c: 'g-f' }, { f: FOTOS.torneo, c: 'g-g' }, { f: FOTOS.trofeo, c: 'g-h' },
];
const iconos = ['escudo', 'lupa', 'trofeo', 'reloj'];
---
<Base titulo="Conoce la tienda" descripcion={`${tienda.nombre}: tienda física de cartas Pokémon TCG en ${tienda.direccion.ciudad} con vitrina de coleccionista, zona de juego y tasación en mostrador.`} pagina="tienda">
  <section class="tienda-hero osc">
    <div class="tienda-hero-foto"><Foto src={FOTOS.tienda.src} alt={FOTOS.tienda.alt} prioridad sizes="100vw" /></div>
    <div class="contenedor tienda-hero-texto">
      <p class="etiqueta">{tienda.nombre} · desde {tienda.desde} · {tienda.direccion.ciudad}</p>
      <h1 class="h1">Una tienda hecha por coleccionistas, para coleccionistas.</h1>
      <p class="entradilla">Empezamos con una vitrina y una mesa. Hoy tenemos {tienda.espacios[0].dato} para jugar, cientos de cartas revisadas una a una y una comunidad que llena la tienda cada semana.</p>
      <div class="fila"><a class="btn btn--acento" href="#visita">Cómo llegar</a><a class="btn btn--fantasma" href="#galeria">Ver fotos</a></div>
    </div>
  </section>

  <section class="seccion blanca">
    <div class="contenedor dos-col" style="align-items:start">
      <div class="pila" style="--pila:18px">
        <p class="etiqueta">Nuestra forma de trabajar</p>
        <h2 class="h2">Precio claro, estado revisado y tiempo para hablar de cartas.</h2>
      </div>
      <div class="pila" style="--pila:16px">
        <p class="entradilla" style="color:var(--tinta)">Creemos que una tienda de cartas tiene que ser un sitio donde te sientas cómodo preguntando, tanto si buscas tu primer mazo como una carta graduada para tu colección.</p>
        <p class="entradilla">Por eso cada carta de la vitrina lleva su precio y su estado, te dejamos verla de cerca antes de decidir y, si vienes a vender, revisamos tu colección contigo y te explicamos cada número.</p>
      </div>
    </div>
    <div class="contenedor" style="margin-top:clamp(2.5rem,5vw,4rem)">
      <ul class="diferenciales" role="list">
        {tienda.diferenciales.map((d, i) => <li data-revela style={`--retraso:${i * 80}ms`}><span class="dif-ico" set:html={icono(iconos[i] ?? 'destello')} /><h3 class="h3">{d.titulo}</h3><p>{d.texto}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="seccion osc">
    <div class="contenedor">
      <div class="cab-seccion"><div><p class="etiqueta">Los espacios</p><h2 class="h2">Tres zonas, una misma idea: que estés a gusto.</h2></div></div>
      <div class="espacios">
        {[FOTOS.zonaJuego, FOTOS.vitrina, FOTOS.tasacion].map((f, i) => (
          <article class="espacio" data-revela style={`--retraso:${i * 90}ms`}>
            <div class="espacio-foto"><Foto src={f.src} alt={f.alt} sizes="(min-width: 960px) 33vw, 100vw" anchos={[480, 800]} /></div>
            <div class="espacio-texto"><span class="cifra espacio-dato">{tienda.espacios[i].dato}</span><h3 class="h3">{tienda.espacios[i].titulo}</h3><p>{tienda.espacios[i].texto}</p></div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="seccion clara" id="galeria">
    <div class="contenedor">
      <div class="cab-seccion"><div><p class="etiqueta">Galería · {galeria.length} fotos</p><h2 class="h2">Así es un día cualquiera en la tienda.</h2></div><p class="entradilla" style="max-width:36ch">Toca una foto para verla en grande.</p></div>
      <div class="galeria">
        {galeria.map((g, i) => (
          <button type="button" class={`galeria-item ${g.c}`} data-foto={i} aria-label={`Ampliar foto: ${g.f.alt}`}>
            <Foto src={g.f.src} alt="" sizes="(min-width: 960px) 33vw, 50vw" anchos={[400, 800]} />
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="seccion blanca" id="visita">
    <div class="contenedor dos-col">
      <div class="pila" style="--pila:18px">
        <p class="etiqueta"><span class="punto-vivo" data-punto-tienda></span><span data-estado-tienda>Horario</span></p>
        <h2 class="h2">Te esperamos.</h2>
        <p class="entradilla">{direccionCompleta}. {tienda.direccion.comoLlegar}</p>
        <Horario />
        <div class="fila"><a class="btn btn--wa" href={enlaceWhatsApp()} target="_blank" rel="noopener"><Fragment set:html={icono('whatsapp')} />Escríbenos</a><a class="btn btn--fantasma" href="/contacto/">Contacto</a></div>
      </div>
      <Mapa />
    </div>
  </section>

  <dialog id="dlg-foto" class="osc visor" aria-label="Foto ampliada">
    <div class="dlg-cab"><p class="etiqueta" data-visor-num></p><button class="btn-icono dlg-cerrar" type="button" data-cerrar aria-label="Cerrar" set:html={icono('cerrar')} /></div>
    <figure class="visor-fig">
      {galeria.map((g, i) => <div class="visor-foto" data-visor={i} hidden><Foto src={g.f.src} alt={g.f.alt} sizes="90vw" anchos={[800, 1200, 1600]} /></div>)}
      <figcaption data-visor-pie></figcaption>
    </figure>
    <div class="fila visor-nav"><button class="btn btn--suave btn--peq" type="button" data-visor-mover="-1"><Fragment set:html={icono('atras')} />Anterior</button><button class="btn btn--suave btn--peq" type="button" data-visor-mover="1">Siguiente<Fragment set:html={icono('flecha')} /></button></div>
  </dialog>

  <style is:global>
    .tienda-hero { position: relative; isolation: isolate; min-height: min(78svh, 720px); display: flex; align-items: flex-end; padding-block: clamp(4rem, 10vw, 7rem) clamp(2.5rem, 6vw, 4.5rem); overflow: hidden; }
    .tienda-hero-foto { position: absolute; inset: 0; z-index: -2; }
    .tienda-hero-foto img { width: 100%; height: 100%; object-fit: cover; }
    .tienda-hero::before { content: ''; position: absolute; inset: 0; z-index: -1; background: linear-gradient(to top, rgba(11,10,20,.95) 10%, rgba(11,10,20,.35) 60%, rgba(11,10,20,.55)); }
    .tienda-hero-texto { display: grid; gap: 20px; }
    .tienda-hero h1 { max-width: 16ch; }
    .tienda-hero .entradilla { color: #d9d5e8; }
    .diferenciales { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr)); }
    .diferenciales li { display: grid; gap: 10px; align-content: start; padding: 22px; border-radius: 20px; background: var(--nacar); }
    .diferenciales p { color: var(--gris); font-size: .94rem; }
    .dif-ico { display: grid; place-items: center; width: 46px; height: 46px; border-radius: 14px; background: var(--noche); color: var(--acento); }
    .espacios { display: grid; gap: 16px; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); }
    .espacio { border-radius: 24px; overflow: hidden; background: var(--noche-2); border: 1px solid var(--linea-osc); }
    .espacio-foto { aspect-ratio: 4 / 3; overflow: hidden; }
    .espacio-foto img { width: 100%; height: 100%; object-fit: cover; transition: transform 1s var(--ease); }
    .espacio:hover .espacio-foto img { transform: scale(1.05); }
    .espacio-texto { display: grid; gap: 8px; padding: 20px; }
    .espacio-texto p { color: var(--niebla); font-size: .94rem; }
    .espacio-dato { font-size: 1.6rem; font-weight: 700; color: var(--acento); letter-spacing: -.03em; }
    .galeria { display: grid; gap: 10px; grid-template-columns: repeat(2, 1fr); grid-auto-rows: clamp(120px, 22vw, 240px); }
    .galeria-item { position: relative; padding: 0; border: 0; border-radius: 18px; overflow: hidden; cursor: zoom-in; background: var(--nacar-2); }
    .galeria-item img { width: 100%; height: 100%; object-fit: cover; transition: transform .9s var(--ease); }
    .galeria-item:hover img { transform: scale(1.06); }
    @media (min-width: 900px) {
      .galeria { grid-template-columns: repeat(4, 1fr); grid-auto-flow: dense; }
      .g-a { grid-column: span 2; grid-row: span 2; } .g-d { grid-row: span 2; }
    }
    .visor { width: min(100% - 24px, 1100px); }
    .visor-fig { padding: 0 22px; display: grid; gap: 12px; }
    .visor-foto img { width: 100%; max-height: 68svh; object-fit: contain; border-radius: 14px; }
    .visor-fig figcaption { color: var(--niebla); font-size: .92rem; }
    .visor-nav { justify-content: space-between; padding: 16px 22px 22px; }
  </style>
  <script>
    import { $, $$, abrir } from '../scripts/ui.ts';
    const items = $$('[data-visor]');
    let actual = 0;
    function mostrar(i: number) {
      actual = (i + items.length) % items.length;
      items.forEach((el, k) => (el.hidden = k !== actual));
      const img = items[actual].querySelector('img');
      $('[data-visor-pie]')!.textContent = img?.alt ?? '';
      $('[data-visor-num]')!.textContent = `${actual + 1} de ${items.length}`;
    }
    for (const b of $$('[data-foto]')) b.addEventListener('click', () => { mostrar(+b.dataset.foto!); abrir('dlg-foto'); });
    $('#dlg-foto')!.addEventListener('click', (ev) => {
      const m = (ev.target as HTMLElement).closest<HTMLElement>('[data-visor-mover]');
      if (m) mostrar(actual + +m.dataset.visorMover!);
    });
    $('#dlg-foto')!.addEventListener('keydown', (ev) => {
      if (ev.key === 'ArrowRight') mostrar(actual + 1);
      if (ev.key === 'ArrowLeft') mostrar(actual - 1);
    });
  </script>
</Base>
