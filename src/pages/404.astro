---
import Base from '../layouts/Base.astro';
import { icono } from '../lib/iconos.ts';
---
<Base titulo="Página no encontrada" descripcion="Esta página no existe." noindex>
  <section class="seccion osc" style="min-height:70svh;display:grid;place-items:center;text-align:center">
    <div class="contenedor pila" style="--pila:20px;justify-items:center">
      <p class="etiqueta">Error 404</p>
      <h1 class="h1">Esta carta no está en la carpeta.</h1>
      <p class="entradilla">La página que buscas no existe o ha cambiado de sitio.</p>
      <div class="fila" style="justify-content:center">
        <a class="btn btn--acento" href="/">Volver al inicio</a>
        <a class="btn btn--fantasma" href="/catalogo/">Ir al catálogo</a>
        <button class="btn btn--fantasma" type="button" data-abrir="dlg-buscar"><Fragment set:html={icono('buscar')} />Buscar</button>
      </div>
    </div>
  </section>
</Base>
