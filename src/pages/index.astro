---
import Base from '../layouts/Base.astro';
import Foto from '../components/Foto.astro';
import Mapa from '../components/Mapa.astro';
import Horario from '../components/Horario.astro';
import '../styles/tienda.css';
import '../styles/torneos.css';
import { tienda, direccionCompleta, enlaceWhatsApp, enlaceMapa } from '../data/tienda.ts';
import { PRODUCTOS, CATEGORIAS, EXPANSIONES } from '../data/catalogo.ts';
import { FOTOS } from '../data/fotos.ts';
import { estadoInicial } from '../lib/almacen.ts';
import { tarjetaProducto } from '../lib/vistas/producto.ts';
import { tarjetaTorneo, destacado as destacadoHTML, podio, textoProximo, proximoConPlazas, rutaTorneo } from '../lib/vistas/torneo.ts';
import { calcularRanking, temporadaDe } from '../lib/ranking.ts';
import { horarioSchema } from '../lib/horario.ts';
import { icono } from '../lib/iconos.ts';
import { recomendar, RESPUESTAS_INICIALES } from '../lib/asistente.ts';

const ahora = new Date();
const e = estadoInicial(ahora);
const proximos = e.torneos.filter((t) => !t.finalizado && Date.parse(t.inicio) > ahora.getTime()).sort((a, b) => Date.parse(a.inicio) - Date.parse(b.inicio));
const grande = proximos.find((t) => t.destacado) ?? proximos[0];
const tres = proximos.filter((t) => t !== grande).slice(0, 3);
const rk = calcularRanking(e.torneos, e.jugadores, temporadaDe(ahora.toISOString()).id);
const temporadaTorneos = e.torneos.filter((t) => t.finalizado && temporadaDe(t.inicio).id === temporadaDe(ahora.toISOString()).id).length;

const cuenta = (c: string) => PRODUCTOS.filter((p) => p.categoria === c).length;
const listas = {
  novedades: PRODUCTOS.filter((p) => p.alta <= 20).sort((a, b) => a.alta - b.alta).slice(0, 8),
  buscados: PRODUCTOS.filter((p) => p.etiquetas.includes('mas-buscado')).slice(0, 8),
  vitrina: PRODUCTOS.filter((p) => p.categoria === 'cartas' && p.precio >= 40).sort((a, b) => b.precio - a.precio).slice(0, 8),
};
const expAsistente = EXPANSIONES.filter((x) => ['megaevolucion', '151', 'prismaticas', 'mascaras', 'escarlata-purpura'].includes(x.id));
const fotoCat: Record<string, string> = { cartas: 'umbreon-ex-pre-161', sobres: 'sobre-megaevolucion', cajas: 'etb-prismaticas', coleccion: 'charizard-base-psa8', accesorios: 'archivador-9' };
const proximo = proximos.length ? proximoConPlazas(proximos, ahora) : null;

const ld = {
  '@context': 'https://schema.org',
  '@type': 'HobbyShop',
  '@id': new URL('/#tienda', Astro.site).href,
  name: tienda.nombreCompleto,
  description: tienda.descripcionSeo,
  url: new URL('/', Astro.site).href,
  telephone: tienda.contacto.telefonoEnlace,
  email: tienda.contacto.email,
  priceRange: '€€',
  image: new URL('/og.jpg', Astro.site).href,
  address: { '@type': 'PostalAddress', streetAddress: tienda.direccion.calle, postalCode: tienda.direccion.cp, addressLocality: tienda.direccion.ciudad, addressRegion: tienda.direccion.provincia, addressCountry: tienda.direccion.pais },
  geo: { '@type': 'GeoCoordinates', latitude: tienda.direccion.lat, longitude: tienda.direccion.lng },
  openingHoursSpecification: horarioSchema(tienda.horario),
  sameAs: tienda.redes.map((r) => r.url),
  hasMap: enlaceMapa,
};
---
<Base titulo={`${tienda.nombre} · Tienda de cartas Pokémon TCG en ${tienda.direccion.ciudad}`} descripcion={tienda.descripcionSeo} pagina="inicio" jsonld={ld}>
  <section class="banner">
    <div class="contenedor banner-in">
      <div class="banner-texto">
        <p class="banner-aviso">Ya a la venta</p>
        <h1>Megaevolución ya está en tienda</h1>
        <p class="banner-sub">Sobres, cajas de 36 sobres y Cajas de Entrenador Élite de la nueva expansión. Resérvalo por WhatsApp y recógelo en nuestra tienda de {tienda.direccion.ciudad}.</p>
        <div class="fila">
          <a class="btn btn--acento" href="/catalogo/?expansion=megaevolucion">Ver Megaevolución</a>
          <a class="btn btn--fantasma" href="/catalogo/">Todo el catálogo</a>
        </div>
      </div>
      <div class="banner-productos" aria-hidden="true">
        <img class="bp-caja" src="/productos/display-megaevolucion.webp" width="600" height="600" alt="" fetchpriority="high" />
        <img class="bp-etb" src="/productos/etb-megaevolucion.webp" width="600" height="600" alt="" />
        <img class="bp-sobre" src="/productos/sobre-megaevolucion.webp" width="600" height="600" alt="" />
      </div>
    </div>
  </section>
  <div class="franja-info">
    <div class="contenedor franja-info-in">
      <a href="/contacto/#horario"><span class="punto-vivo" data-punto-tienda></span><span><strong data-estado-tienda>Consulta el horario</strong><small>{direccionCompleta}</small></span></a>
      {proximo && (
        <a href={rutaTorneo(proximo)} data-proximo-torneo><Fragment set:html={icono('trofeo')} /><span><strong>Próximo torneo</strong><small data-texto>{textoProximo(proximo, ahora)}</small></span></a>
      )}
      <a href="/vende-tu-coleccion/"><Fragment set:html={icono('intercambio')} /><span><strong>Compramos tu colección</strong><small>Tasación gratis en tienda</small></span></a>
    </div>
  </div>

  <section class="seccion blanca" aria-labelledby="t-cat">
    <div class="contenedor">
      <div class="cab-seccion">
        <h2 class="h2" id="t-cat">Comprar por categoría</h2>
        <a class="enlace-flecha" href="/catalogo/">Ver todo el catálogo <Fragment set:html={icono('flecha')} /></a>
      </div>
      <div class="categorias">
        {CATEGORIAS.map((c) => (
          <a class="categoria" href={`/catalogo/?categoria=${c.id}`}>
            <img src={`/productos/${fotoCat[c.id]}.webp`} width="600" height="600" alt="" loading="lazy" decoding="async" />
            <span class="categoria-nombre">{c.plural}</span>
            <span class="categoria-num">{cuenta(c.id)} productos</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="seccion clara" aria-labelledby="t-esc">
    <div class="contenedor">
      <div class="carrusel" data-carrusel>
        <div class="carrusel-cab">
          <h2 class="h2" id="t-esc">Destacados</h2>
          <div class="chips" role="tablist" aria-label="Selección de productos">
            <button class="chip" role="tab" aria-selected="true" data-lista="novedades">Novedades</button>
            <button class="chip" role="tab" aria-selected="false" data-lista="buscados">Lo más buscado</button>
            <button class="chip" role="tab" aria-selected="false" data-lista="vitrina">Cartas de vitrina</button>
          </div>
          <div class="carrusel-flechas">
            <button class="btn-icono" type="button" data-mover="-1" aria-label="Anteriores" set:html={icono('atras')} />
            <button class="btn-icono" type="button" data-mover="1" aria-label="Siguientes" set:html={icono('flecha')} />
          </div>
        </div>
        {Object.entries(listas).map(([k, l], i) => (
          <div class="carrusel-pista" role="tabpanel" data-panel={k} hidden={i !== 0} tabindex="0" aria-label={k}>
            <Fragment set:html={l.map((p) => String(tarjetaProducto(p, e.productos[p.id]))).join('')} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="seccion osc" aria-labelledby="t-tor">
    <div class="contenedor">
      <div class="cab-seccion">
        <div>
          <h2 class="h2" id="t-tor">Próximos torneos</h2>
          <p class="entradilla">Apúntate desde la web y sigue los resultados ronda a ronda. Llevamos {temporadaTorneos} torneos esta temporada.</p>
        </div>
        <a class="enlace-flecha" href="/torneos/">Calendario completo <Fragment set:html={icono('flecha')} /></a>
      </div>
      <div class="pila" style="--pila:22px" data-inicio-torneos>
        {grande && <Fragment set:html={String(destacadoHTML(grande, ahora))} />}
        <div class="rejilla-torneos"><Fragment set:html={tres.map((t) => String(tarjetaTorneo(t, ahora))).join('')} /></div>
      </div>
      <div class="dos-col" style="margin-top:clamp(2.5rem,5vw,4rem)">
        <div class="pila" style="--pila:14px">
          <h3 class="h2">Clasificación de la temporada</h3>
          <p class="entradilla">Sumas puntos por jugar, por cada partida ganada y por tu puesto final en cada torneo.</p>
          <a class="btn btn--fantasma" style="justify-self:start" href="/torneos/clasificacion/">Ver clasificación completa</a>
        </div>
        <div data-inicio-podio><Fragment set:html={String(podio(rk, e.jugadores))} /></div>
      </div>
    </div>
  </section>

  <section class="seccion clara" aria-labelledby="t-asis">
    <div class="contenedor">
      <div class="cab-seccion">
        <div>
          <h2 class="h2" id="t-asis">¿Buscas un regalo?</h2>
          <p class="entradilla">Marca qué buscas y cuánto quieres gastar, y te enseñamos lo que tenemos en tienda.</p>
        </div>
      </div>
      <form class="asistente" data-asistente>
        <div class="asistente-pasos">
          <fieldset>
            <legend>Qué buscas</legend>
            <div class="chips">
              {[['todo', 'Cualquier cosa'], ['cartas', 'Cartas sueltas'], ['sobres', 'Sobres y cajas'], ['accesorios', 'Accesorios']].map(([v, n], i) => (
                <label class="chip"><input type="radio" name="tipo" value={v} checked={i === 0} />{n}</label>
              ))}
            </div>
          </fieldset>
          <fieldset>
            <legend>Para qué</legend>
            <div class="chips">
              {[['', 'Me da igual'], ['coleccion', 'Coleccionar'], ['jugar', 'Jugar'], ['regalo', 'Regalar'], ['empezar', 'Empezar a jugar']].map(([v, n], i) => (
                <label class="chip"><input type="radio" name="uso" value={v} checked={i === 0} />{n}</label>
              ))}
            </div>
          </fieldset>
          <fieldset>
            <legend>Presupuesto</legend>
            <div class="chips">
              {[['0-15', 'Hasta 15 €'], ['15-60', '15–60 €'], ['60-150', '60–150 €'], ['0-99999', 'Sin límite']].map(([v, n], i) => (
                <label class="chip"><input type="radio" name="presupuesto" value={v} checked={i === 3} />{n}</label>
              ))}
            </div>
          </fieldset>
          <fieldset>
            <legend>Expansión</legend>
            <div class="chips">
              <label class="chip"><input type="radio" name="expansion" value="" checked />Cualquiera</label>
              {expAsistente.map((x) => <label class="chip"><input type="radio" name="expansion" value={x.id} />{x.nombre}</label>)}
            </div>
          </fieldset>
        </div>
        <div class="asistente-resultado" aria-live="polite" data-asistente-resultado set:html={recomendar(RESPUESTAS_INICIALES, e.productos)} />
      </form>
    </div>
  </section>

  <section class="seccion blanca" aria-labelledby="t-tienda">
    <div class="contenedor dos-col dos-col--ancha">
      <div class="collage">
        <figure class="c1"><Foto src={FOTOS.tienda.src} alt={FOTOS.tienda.alt} sizes="(min-width: 960px) 40vw, 100vw" /></figure>
        <figure class="c2"><Foto src={FOTOS.zonaJuego.src} alt={FOTOS.zonaJuego.alt} sizes="(min-width: 960px) 20vw, 50vw" anchos={[400, 800]} /></figure>
        <figure class="c3"><Foto src={FOTOS.comunidad.src} alt={FOTOS.comunidad.alt} sizes="(min-width: 960px) 20vw, 50vw" anchos={[400, 800]} /></figure>
      </div>
      <div class="pila" style="--pila:18px">
        <h2 class="h2" id="t-tienda">La tienda</h2>
        <p class="entradilla">Abrimos en {tienda.desde} en {tienda.direccion.ciudad}. Tenemos cartas sueltas con el precio a la vista, producto sellado de cada expansión y una zona de juego con {tienda.espacios[0].dato} donde jugamos liga y torneos todas las semanas.</p>
        <ul class="lista-simple" role="list">
          {tienda.espacios.map((s) => <li><strong>{s.titulo}.</strong> {s.texto}</li>)}
        </ul>
        <a class="btn btn--fantasma" style="justify-self:start" href="/tienda/">Ver fotos de la tienda</a>
      </div>
    </div>
  </section>

  <section class="seccion osc" aria-labelledby="t-vende">
    <div class="contenedor dos-col">
      <div class="pila" style="--pila:18px">
        <h2 class="h2" id="t-vende">Compramos tu colección</h2>
        <p class="entradilla">¿Tienes cartas guardadas en una carpeta o en una caja? Mándanos unas fotos y te decimos cuánto te podemos ofrecer. Pagamos en efectivo o en crédito de tienda (un 20 % más).</p>
        <ol class="pasos" role="list">
          <li><strong>Nos mandas fotos</strong><p>Desde el formulario o por WhatsApp.</p></li>
          <li><strong>Te damos un precio orientativo</strong><p>Normalmente en menos de 24 horas.</p></li>
          <li><strong>Lo cerramos en tienda</strong><p>Revisamos las cartas contigo y cobras en el momento.</p></li>
        </ol>
        <a class="btn btn--acento" style="justify-self:start" href="/vende-tu-coleccion/">Pedir valoración</a>
      </div>
      <div class="foto-marco foto-marco--alta"><Foto src={FOTOS.tasacion.src} alt={FOTOS.tasacion.alt} sizes="(min-width: 960px) 45vw, 100vw" /></div>
    </div>
  </section>

  <section class="seccion clara" aria-labelledby="t-visita" id="visitanos">
    <div class="contenedor dos-col">
      <div class="pila" style="--pila:18px">
        <h2 class="h2" id="t-visita">Horario y cómo llegar</h2>
        <p class="entradilla">{direccionCompleta}. {tienda.direccion.comoLlegar}</p>
        <Horario />
        <div class="fila">
          <a class="btn btn--wa" href={enlaceWhatsApp()} target="_blank" rel="noopener"><Fragment set:html={icono('whatsapp')} />WhatsApp</a>
          <a class="btn btn--fantasma" href={`tel:${tienda.contacto.telefonoEnlace}`}><Fragment set:html={icono('telefono')} />{tienda.contacto.telefono}</a>
        </div>
      </div>
      <Mapa />
    </div>
  </section>
  <script>
    import '../scripts/inicio.ts';
  </script>
</Base>
